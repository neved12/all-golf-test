# ALL:GOLF 서버 환경변수 예시
#
# 사용법
#   1) 이 파일을 복사해 같은 위치에 `.env` 로 저장합니다.  (cp .env.example .env)
#   2) 아래 값을 실제 값으로 바꿉니다.
#   3) `.env` 는 .gitignore 로 제외되어 GitHub에 올라가지 않습니다.
#
# 값을 비워 두면 서버는 "시연용 기본값"으로 동작하며, 시작 로그에 경고를 표시합니다.
# 시연용 기본값은 실제 운영 비밀번호가 아니며, 외부에 공개된 저장소에 그대로 두어도
# 운영 계정으로 사용할 수 없도록 설계했습니다. 다만 실제 데이터를 넣는 순간에는
# 반드시 아래 값을 채우고 서버를 사내망/터널 뒤에 두세요.

# 본사 관리자 비밀번호 (필수 권장)
# 시연 기본값: allgolf-demo-2026
ADMIN_PASSWORD=

# 본사 관리자 이메일 (선택, 입력하면 로그인 시 이메일도 일치해야 합니다)
ADMIN_EMAIL=admin@allgolf.demo

# 세션 토큰 서명 키 (필수 권장, 32자 이상 임의 문자열)
# 본사 관리자와 골프장 담당자 세션 모두 이 키로 서명합니다(토큰 접두사·키 유도는 분리).
# 비워 두면 서버가 시작할 때마다 임의 키를 만들어 사용합니다.
# (서버를 재시작하면 기존 로그인 세션이 모두 만료됩니다.)
SESSION_SECRET=

# 세션 만료 시간(시간 단위)
SESSION_TTL_HOURS=8
PARTNER_SESSION_TTL_HOURS=12

# 서버 포트와 바인딩 주소
PORT=4173
# 집 안에서만 쓰려면 127.0.0.1, 같은 공유기의 휴대폰에서도 접속하려면 0.0.0.0
HOST=127.0.0.1

# DB 파일 경로 (비워 두면 server/data/db.json)
ALLGOLF_DB_PATH=

# 정적 페이지를 다른 출처(GitHub Pages, 터널 주소)에서 열고 이 서버에 붙일 때 허용할 출처
# 쉼표로 구분합니다. 예: https://neved12.github.io,https://abc.trycloudflare.com
ALLGOLF_ALLOWED_ORIGINS=

# HTTPS 뒤에서 쿠키에 Secure 속성을 붙이려면 1
ALLGOLF_SECURE_COOKIE=0

# --- 7단계: 골프장 담당자 계정 ------------------------------------------------
# 골프장 담당자 계정은 기본적으로 본사 관리자 화면 > 제휴 계정 관리에서 만듭니다.
# 아래 값은 시연 편의용이며, 실제 운영에서는 자동 생성을 끄고 화면에서만 발급하세요.

# 서버 시작 시 제휴 승인 골프장마다 시연용 담당자 계정을 자동 생성하려면 1
ALLGOLF_SEED_DEMO_PARTNER_ACCOUNTS=0

# 자동 생성/스크립트(npm run demo:partner-accounts)에서 쓸 시연용 비밀번호
# 시연 기본값: allgolf-partner-2026 (8자 이상, 영문+숫자)
DEMO_PARTNER_PASSWORD=

# --- 8단계: 예약 임시확보(Hold) -----------------------------------------------
# 결제 화면에서 1팀을 잡아 두는 시간(초). 기본 300초(5분).
# 만료되면 조회·예약 시점과 주기 정리에서 자동으로 재고가 복구됩니다.
ALLGOLF_HOLD_TTL_SECONDS=300

# 만료된 Hold 를 정리하는 주기(초). 기본 30초.
ALLGOLF_HOLD_SWEEP_SECONDS=30

# 한 예약 세션(브라우저 탭)이 동시에 잡아 둘 수 있는 Hold 수. 기본 3.
ALLGOLF_MAX_HOLDS=3
