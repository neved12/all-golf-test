# ALL:GOLF 서버 환경변수 예시
#
# 사용법
#   1) 이 파일을 복사해 같은 위치에 `.env` 로 저장합니다.  (cp .env.example .env)
#   2) 아래 값을 실제 값으로 바꿉니다.
#   3) `.env` 는 .gitignore 로 제외되어 GitHub에 올라가지 않습니다.
#
# 값을 비워 두면 서버는 "시연용 기본값"으로 동작하며, 시작 로그에 경고를 표시합니다.
# 시연용 기본값은 실제 운영 비밀번호가 아니며, 외부에 공개된 저장소에 그대로 두어도
# 운영 계정으로 사용할 수 없도록 설계했습니다. 다만 실제 데이터를 넣는 순간에는
# 반드시 아래 값을 채우고 서버를 사내망/터널 뒤에 두세요.

# 본사 관리자 비밀번호 (필수 권장)
# 시연 기본값: allgolf-demo-2026
ADMIN_PASSWORD=

# 본사 관리자 이메일 (선택, 입력하면 로그인 시 이메일도 일치해야 합니다)
ADMIN_EMAIL=admin@allgolf.demo

# 세션 토큰 서명 키 (필수 권장, 32자 이상 임의 문자열)
# 비워 두면 서버가 시작할 때마다 임의 키를 만들어 사용합니다.
# (서버를 재시작하면 기존 로그인 세션이 모두 만료됩니다.)
SESSION_SECRET=

# 서버 포트와 바인딩 주소
PORT=4173
# 집 안에서만 쓰려면 127.0.0.1, 같은 공유기의 휴대폰에서도 접속하려면 0.0.0.0
HOST=127.0.0.1

# DB 파일 경로 (비워 두면 server/data/db.json)
ALLGOLF_DB_PATH=

# 정적 페이지를 다른 출처(GitHub Pages, 터널 주소)에서 열고 이 서버에 붙일 때 허용할 출처
# 쉼표로 구분합니다. 예: https://neved12.github.io,https://abc.trycloudflare.com
ALLGOLF_ALLOWED_ORIGINS=

# HTTPS 뒤에서 쿠키에 Secure 속성을 붙이려면 1
ALLGOLF_SECURE_COOKIE=0
