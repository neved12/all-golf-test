# Node 산출물
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# 로컬 환경·임시 파일
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.tmp
*.bak

# 서버 런타임 DB (개인정보가 들어갈 수 있으므로 저장소에 올리지 않는다)
# 시드/백업 구조는 server/data/README.md 참고
server/data/db.json
server/data/db.json.tmp-*
server/data/*.lock
server/data/db.corrupt-*.json
server/data/backups/

# 원본 자료(PDF·CSV·ZIP)는 재배포하지 않습니다. 로컬에서만 내려받아 사용하고,
# 정제 결과(JSON 레이어)와 생성 스크립트·검증 보고서만 커밋합니다.
data/sources/*.pdf
data/sources/*.csv
data/sources/*.zip
